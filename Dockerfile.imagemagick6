# Dockerfile for testing with ImageMagick 6
# Debian packages include ImageMagick 6 by default
FROM ruby:3.3-slim-bookworm

# Install ImageMagick 6 and build dependencies
RUN apt-get update && apt-get install -y \
    imagemagick \
    libmagickwand-dev \
    build-essential \
    git \
    fonts-freefont-ttf \
    fontconfig \
    && rm -rf /var/lib/apt/lists/*

# Verify ImageMagick version is 6.x (fail build if not)
RUN convert --version && \
    convert --version | grep -q "ImageMagick 6\." || \
    (echo "ERROR: Expected ImageMagick 6.x but got:" && convert --version && exit 1)

WORKDIR /app

COPY Gemfile avatarly.gemspec ./
COPY Gemfile.lock* ./
COPY lib ./lib
COPY assets ./assets
COPY spec ./spec

RUN bundle install

CMD ["bundle", "exec", "rspec", "--format", "documentation"]

